package layout

templ Footer() {
	<footer class="bg-surface-container-highest border-t border-outline-variant mt-auto py-lg">
		<div class="flex flex-col md:flex-row justify-between items-center w-full px-gutter max-w-container-max mx-auto gap-md">
			<div class="flex flex-col gap-xs items-center md:items-start">
				<span class="font-headline-md text-headline-md text-primary font-bold">ClubManager</span>
				<p class="font-body-sm text-body-sm text-on-surface-variant">&copy; 2025 ClubManager. Tous droits réservés.</p>
			</div>
			<nav class="flex flex-wrap justify-center gap-md">
				<a href="#" class="text-on-surface-variant hover:text-primary transition-colors font-body-sm text-body-sm">Confidentialité</a>
				<a href="#" class="text-on-surface-variant hover:text-primary transition-colors font-body-sm text-body-sm">CGU</a>
				<a href="#" class="text-on-surface-variant hover:text-primary transition-colors font-body-sm text-body-sm">Contact</a>
				<a href="#" class="text-on-surface-variant hover:text-primary transition-colors font-body-sm text-body-sm">Aide</a>
			</nav>
		</div>
	</footer>
}
