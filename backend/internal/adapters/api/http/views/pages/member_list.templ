package pages

import (
	"clubmanager/internal/adapters/api/http/views/layout"
	"clubmanager/internal/domain/members"
)

templ MemberList(userMembers []*members.Member) {
	@layout.Page("Mes profils membres", true) {
		<div class="flex items-center justify-between mb-lg">
			<h1 class="font-headline-lg text-headline-lg text-on-surface">Mes profils membres</h1>
			<a
				href="/members/new"
				class="inline-flex items-center gap-xs bg-primary text-on-primary px-md py-3 rounded-lg font-bold font-body-md text-body-md hover:bg-primary-container transition-colors no-underline"
			>
				<span class="material-symbols-outlined text-[20px]">person_add</span>
				Nouveau profil
			</a>
		</div>
		if len(userMembers) == 0 {
			<div class="bg-surface rounded-xl card-shadow p-xl text-center">
				<span class="material-symbols-outlined text-[48px] text-outline opacity-40">person_off</span>
				<p class="font-body-md text-body-md text-on-surface-variant mt-sm mb-lg">Vous n'avez pas encore de profil membre.</p>
				<a
					href="/members/new"
					class="inline-flex items-center gap-xs bg-primary text-on-primary px-md py-3 rounded-lg font-bold font-body-md text-body-md hover:bg-primary-container transition-colors no-underline"
				>
					<span class="material-symbols-outlined text-[18px]">person_add</span>
					Créer mon premier profil
				</a>
			</div>
		} else {
			<div class="flex flex-col gap-sm">
				for _, m := range userMembers {
					<div class="bg-surface rounded-xl card-shadow p-md flex items-center gap-md">
						<div class="w-12 h-12 rounded-full bg-secondary-container flex items-center justify-center flex-shrink-0">
							<span class="font-bold font-body-lg text-body-lg text-on-secondary-container">
								{ string([]rune(m.Firstname)[0:1]) }
							</span>
						</div>
						<div class="flex-1">
							<p class="font-bold font-body-lg text-body-lg text-on-surface">{ m.Firstname } { m.Lastname }</p>
							<p class="font-body-sm text-body-sm text-on-surface-variant">{ formatBirthdate(m.Birthdate) } · { formatGender(m.Gender) }</p>
						</div>
						if m.IsPrimary {
							<span class="font-data-label text-data-label bg-secondary-container text-on-secondary-container px-md py-1.5 rounded-full">Principal</span>
						}
						<div class="flex items-center gap-xs flex-shrink-0">
							<a
								href={ templ.SafeURL("/members/" + m.Id.String() + "/edit") }
								class="inline-flex items-center gap-xs px-sm py-1.5 bg-surface-container text-on-surface-variant rounded-lg font-bold font-body-sm text-body-sm hover:bg-surface-container-high transition-colors no-underline border border-outline-variant"
							>
								<span class="material-symbols-outlined text-[16px]">edit</span>
								Modifier
							</a>
							<form id={ "delete-member-form-" + m.Id.String() } method="POST" action={ templ.SafeURL("/members/" + m.Id.String() + "/delete") }>
								<button type="button" data-form-id={ "delete-member-form-" + m.Id.String() } data-message="Supprimer ce profil membre ? Cette action est irréversible." onclick="confirmDelete(this.dataset.formId, this.dataset.message)" class="inline-flex items-center gap-xs px-sm py-1.5 bg-surface-container text-on-surface-variant rounded-lg font-bold font-body-sm text-body-sm hover:bg-red-100 hover:text-red-700 transition-colors cursor-pointer border border-outline-variant">
									<span class="material-symbols-outlined text-[16px]">delete</span>
									Supprimer
								</button>
							</form>
						</div>
					</div>
				}
			</div>
		}
	}
}
