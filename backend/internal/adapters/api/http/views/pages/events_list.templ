package pages

import (
	"clubmanager/internal/adapters/api/http/views/layout"
	"clubmanager/internal/domain/clubs"
	"clubmanager/internal/domain/events"
	"fmt"
	"time"
)

func eventTypeLabel(t string) string {
	switch t {
	case "competition":
		return "Compétition"
	case "stage":
		return "Stage"
	default:
		return "Autre"
	}
}

func eventTypeBadgeClass(t string) string {
	switch t {
	case "competition":
		return "bg-primary-container text-on-primary-container"
	case "stage":
		return "bg-secondary-container text-on-secondary-container"
	default:
		return "bg-surface-container text-on-surface-variant"
	}
}

func eventStatusLabel(s string) string {
	switch s {
	case "open":
		return "Ouvert"
	case "cancelled":
		return "Annulé"
	default:
		return "Brouillon"
	}
}

func eventStatusClass(s string) string {
	switch s {
	case "open":
		return "bg-green-100 text-green-700"
	case "cancelled":
		return "bg-red-100 text-red-700"
	default:
		return "bg-surface-container text-on-surface-variant"
	}
}

var frMonths = [...]string{"jan", "fév", "mar", "avr", "mai", "juin", "juil", "août", "sep", "oct", "nov", "déc"}

func parseDate(s string) (time.Time, bool) {
	for _, layout := range []string{time.RFC3339, "2006-01-02 15:04:05-07", "2006-01-02 15:04:05+00", "2006-01-02"} {
		if t, err := time.Parse(layout, s); err == nil {
			return t, true
		}
	}
	return time.Time{}, false
}

func formatEventDate(s string) string {
	if t, ok := parseDate(s); ok {
		return fmt.Sprintf("%02d %s %d", t.Day(), frMonths[t.Month()-1], t.Year())
	}
	if len(s) >= 10 {
		return s[:10]
	}
	return s
}

func eventDateMonth(s string) string {
	if t, ok := parseDate(s); ok {
		return frMonths[t.Month()-1]
	}
	if len(s) >= 7 {
		return s[5:7]
	}
	return "--"
}

func eventDateDay(s string) string {
	if t, ok := parseDate(s); ok {
		return fmt.Sprintf("%02d", t.Day())
	}
	if len(s) >= 10 {
		return s[8:10]
	}
	return "--"
}

func formatBirthdate(s string) string {
	if t, ok := parseDate(s); ok {
		return fmt.Sprintf("%02d %s %d", t.Day(), frMonths[t.Month()-1], t.Year())
	}
	return s
}

func formatGender(g string) string {
	switch g {
	case "man":
		return "Homme"
	case "woman":
		return "Femme"
	case "mixed":
		return "Mixte"
	default:
		return g
	}
}

func eventDetailURL(ev *events.Event, canManage bool) string {
	if ev.Status == "open" || canManage {
		return "/events/" + ev.Id.String()
	}
	return "#"
}

templ EventsList(club *clubs.Club, evts []*events.Event, total, page, pageSize int, canManage bool) {
	@layout.Page("Événements — "+club.Name, true) {
		<div class="flex items-center justify-between mb-lg">
			<div>
				<a href={ templ.SafeURL("/clubs/" + club.Id.String()) } class="inline-flex items-center gap-xs font-body-sm text-body-sm text-on-surface-variant hover:text-on-surface mb-sm no-underline">
					<span class="material-symbols-outlined text-[16px]">arrow_back</span>
					{ club.Name }
				</a>
				<h1 class="font-headline-lg text-headline-lg text-on-surface">Événements</h1>
			</div>
			if canManage {
				<a
					href={ templ.SafeURL("/clubs/" + club.Id.String() + "/events/create") }
					class="inline-flex items-center gap-xs bg-primary text-on-primary px-md py-3 rounded-lg font-bold font-body-md text-body-md hover:bg-primary-container transition-colors no-underline"
				>
					<span class="material-symbols-outlined text-[20px]">add</span>
					Créer un événement
				</a>
			}
		</div>

		if len(evts) == 0 {
			<div class="bg-surface rounded-xl card-shadow p-xl text-center">
				<span class="material-symbols-outlined text-[48px] text-outline opacity-40">event</span>
				<p class="font-body-md text-body-md text-on-surface-variant mt-sm">Aucun événement pour ce club.</p>
				if canManage {
					<a
						href={ templ.SafeURL("/clubs/" + club.Id.String() + "/events/create") }
						class="inline-flex items-center gap-xs mt-md bg-primary text-on-primary px-md py-3 rounded-lg font-bold font-body-md text-body-md hover:bg-primary-container transition-colors no-underline"
					>
						<span class="material-symbols-outlined text-[20px]">add</span>
						Créer le premier événement
					</a>
				}
			</div>
		} else {
			<div class="flex flex-col gap-sm">
				for _, ev := range evts {
					<a
						href={ templ.SafeURL(eventDetailURL(ev, canManage)) }
						class="bg-surface rounded-xl card-shadow card-hover flex items-center gap-md p-md no-underline group"
					>
						<div class="flex flex-col items-center justify-center bg-tertiary-container px-md py-sm rounded-lg min-w-[60px] flex-shrink-0">
							<span class="font-data-label text-data-label text-on-tertiary-container uppercase tracking-wider">{ eventDateMonth(ev.Date) }</span>
							<span class="font-headline-md text-headline-md leading-none text-on-tertiary-container">{ eventDateDay(ev.Date) }</span>
						</div>
						<div class="flex-1 min-w-0">
							<div class="flex items-center gap-xs mb-xs flex-wrap">
								<span class={ "font-data-label text-data-label px-sm py-0.5 rounded-full " + eventTypeBadgeClass(ev.Type) }>
									{ eventTypeLabel(ev.Type) }
								</span>
								<span class={ "font-data-label text-data-label px-sm py-0.5 rounded-full " + eventStatusClass(ev.Status) }>
									{ eventStatusLabel(ev.Status) }
								</span>
							</div>
							<p class="font-bold font-body-lg text-body-lg text-on-surface truncate">{ ev.Title }</p>
							<p class="font-body-sm text-body-sm text-on-surface-variant">{ formatEventDate(ev.Date) } · { ev.Location }</p>
						</div>
						<span class="material-symbols-outlined text-outline group-hover:text-primary transition-colors flex-shrink-0">chevron_right</span>
					</a>
				}
			</div>

			if total > pageSize {
				<div class="flex items-center justify-center gap-sm bg-surface card-shadow rounded-full px-md py-sm border border-outline-variant mx-auto w-fit mt-lg">
					if page > 1 {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/clubs/%s/events?page=%d", club.Id.String(), page-1)) }
							class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-surface-container text-on-surface hover:bg-surface-container-high no-underline transition-colors"
						>
							<span class="material-symbols-outlined text-[20px]">chevron_left</span>
						</a>
					} else {
						<span class="inline-flex items-center justify-center w-8 h-8 rounded-full text-outline opacity-40">
							<span class="material-symbols-outlined text-[20px]">chevron_left</span>
						</span>
					}
					<span class="font-body-sm text-body-sm text-on-surface-variant px-xs">
						{ fmt.Sprintf("%d / %d", page, (total+pageSize-1)/pageSize) }
					</span>
					if page*pageSize < total {
						<a
							href={ templ.SafeURL(fmt.Sprintf("/clubs/%s/events?page=%d", club.Id.String(), page+1)) }
							class="inline-flex items-center justify-center w-8 h-8 rounded-full bg-surface-container text-on-surface hover:bg-surface-container-high no-underline transition-colors"
						>
							<span class="material-symbols-outlined text-[20px]">chevron_right</span>
						</a>
					} else {
						<span class="inline-flex items-center justify-center w-8 h-8 rounded-full text-outline opacity-40">
							<span class="material-symbols-outlined text-[20px]">chevron_right</span>
						</span>
					}
				</div>
			}
		}
	}
}
