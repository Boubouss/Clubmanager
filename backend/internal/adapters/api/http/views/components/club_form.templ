package components

import "clubmanager/internal/domain/members"

templ ClubForm(errors map[string]string, csrfToken string, userMembers []*members.Member) {
	<form class="flex flex-col gap-md" method="POST" action="/clubs/create" novalidate>
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
			<div class="flex flex-col gap-1.5">
				<label class="font-body-sm text-body-sm font-semibold text-on-surface-variant" for="siren">Numéro SIREN</label>
				<input
					class="w-full px-4 py-3 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface placeholder:text-outline input-focus transition-all"
					type="text" id="siren" name="siren" placeholder="123456789"
				/>
				if msg, ok := errors["siren"]; ok {
					<p class="font-body-sm text-body-sm text-error">{ msg }</p>
				}
			</div>
			<div class="flex flex-col gap-1.5">
				<label class="font-body-sm text-body-sm font-semibold text-on-surface-variant" for="name">Nom du club</label>
				<input
					class="w-full px-4 py-3 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface placeholder:text-outline input-focus transition-all"
					type="text" id="name" name="name" placeholder="Judo Club de Paris"
				/>
				if msg, ok := errors["name"]; ok {
					<p class="font-body-sm text-body-sm text-error">{ msg }</p>
				}
			</div>
		</div>
		<div class="flex flex-col gap-1.5">
			<label class="font-body-sm text-body-sm font-semibold text-on-surface-variant" for="address">Adresse</label>
			<input
				class="w-full px-4 py-3 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface placeholder:text-outline input-focus transition-all"
				type="text" id="address" name="address" placeholder="1 rue du Judo"
			/>
			if msg, ok := errors["address"]; ok {
				<p class="font-body-sm text-body-sm text-error">{ msg }</p>
			}
		</div>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
			<div class="flex flex-col gap-1.5">
				<label class="font-body-sm text-body-sm font-semibold text-on-surface-variant" for="city">Ville</label>
				<input
					class="w-full px-4 py-3 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface placeholder:text-outline input-focus transition-all"
					type="text" id="city" name="city" placeholder="Paris"
				/>
				if msg, ok := errors["city"]; ok {
					<p class="font-body-sm text-body-sm text-error">{ msg }</p>
				}
			</div>
			<div class="flex flex-col gap-1.5">
				<label class="font-body-sm text-body-sm font-semibold text-on-surface-variant" for="postal_code">Code postal</label>
				<input
					class="w-full px-4 py-3 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface placeholder:text-outline input-focus transition-all"
					type="text" id="postal_code" name="postal_code" placeholder="75001"
				/>
				if msg, ok := errors["postal_code"]; ok {
					<p class="font-body-sm text-body-sm text-error">{ msg }</p>
				}
			</div>
		</div>
		<div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
			<div class="flex flex-col gap-1.5">
				<label class="font-body-sm text-body-sm font-semibold text-on-surface-variant" for="country">Pays</label>
				<input
					class="w-full px-4 py-3 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface input-focus transition-all"
					type="text" id="country" name="country" value="France"
				/>
				if msg, ok := errors["country"]; ok {
					<p class="font-body-sm text-body-sm text-error">{ msg }</p>
				}
			</div>
			<div class="flex flex-col gap-1.5">
				<label class="font-body-sm text-body-sm font-semibold text-on-surface-variant" for="phonenumber">
					Téléphone <span class="font-normal text-outline">(optionnel)</span>
				</label>
				<input
					class="w-full px-4 py-3 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface placeholder:text-outline input-focus transition-all"
					type="tel" id="phonenumber" name="phonenumber" placeholder="01 00 00 00 00"
				/>
				if msg, ok := errors["phonenumber"]; ok {
					<p class="font-body-sm text-body-sm text-error">{ msg }</p>
				}
			</div>
		</div>

		<!-- Section profil président -->
		<div class="border-t border-outline-variant pt-md mt-xs flex flex-col gap-md">
			<div>
				<h2 class="font-headline-sm text-headline-sm text-on-surface">Votre profil membre</h2>
				<p class="font-body-sm text-body-sm text-on-surface-variant mt-xs">
					En tant que président, vous serez automatiquement membre du club.
				</p>
			</div>
			<div class="flex flex-col gap-1.5">
				<label class="font-body-sm text-body-sm font-semibold text-on-surface-variant" for="president_member_id">Profil membre</label>
				<select
					id="president_member_id"
					name="president_member_id"
					class="w-full px-4 py-3 bg-surface border border-outline-variant rounded-lg font-body-md text-body-md text-on-surface input-focus transition-all"
					hx-get="/clubs/create/member-fields"
					hx-trigger="change"
					hx-target="#president-member-fields"
					hx-swap="innerHTML"
					hx-include="[name='president_member_id']"
				>
					if len(userMembers) == 0 {
						<option value="new" selected>Créer un nouveau profil</option>
					} else {
						<option value="">-- Choisir un profil --</option>
						for _, m := range userMembers {
							<option value={ m.Id.String() }>{ m.Firstname } { m.Lastname }</option>
						}
						<option value="new">+ Créer un nouveau profil</option>
					}
				</select>
				if msg, ok := errors["president_member_id"]; ok {
					<p class="font-body-sm text-body-sm text-error">{ msg }</p>
				}
			</div>
			<div id="president-member-fields" class="flex flex-col gap-md">
				if len(userMembers) == 0 {
					@MemberFieldsFragment(nil)
				}
			</div>
		</div>

		if msg, ok := errors["club"]; ok {
			<p class="font-body-sm text-body-sm text-error">{ msg }</p>
		}
		if msg, ok := errors["member"]; ok {
			<p class="font-body-sm text-body-sm text-error">{ msg }</p>
		}
		<div class="flex gap-sm pt-2">
			<button
				type="submit"
				class="bg-primary text-on-primary px-6 py-3 rounded-lg font-bold font-body-md text-body-md hover:bg-primary-container transition-colors cursor-pointer border-none"
			>
				Créer le club
			</button>
			<a href="/clubs" class="bg-surface-container text-on-surface px-6 py-3 rounded-lg font-bold font-body-md text-body-md hover:bg-surface-container-high transition-colors no-underline border border-outline-variant">
				Annuler
			</a>
		</div>
	</form>
}
