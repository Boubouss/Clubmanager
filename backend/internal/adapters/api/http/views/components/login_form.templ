package components

templ LoginForm(errors map[string]string, csrfToken string) {
	<form class="flex flex-col gap-md" method="POST" action="/user/connexion" novalidate>
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		<div class="flex flex-col gap-1.5">
			<label class="font-body-sm text-body-sm font-semibold text-on-surface-variant" for="email">Adresse Email</label>
			<input
				class="w-full px-4 py-3 bg-white border border-outline-variant rounded-lg font-body-md text-body-md input-focus transition-all placeholder:text-outline"
				type="email" id="email" name="email" placeholder="vous@exemple.fr"
			/>
			if msg, ok := errors["email"]; ok {
				<p class="font-body-sm text-body-sm text-error mt-1">{ msg }</p>
			}
		</div>
		<div class="flex flex-col gap-1.5">
			<label class="font-body-sm text-body-sm font-semibold text-on-surface-variant" for="password">Mot de passe</label>
			<input
				class="w-full px-4 py-3 bg-white border border-outline-variant rounded-lg font-body-md text-body-md input-focus transition-all placeholder:text-outline"
				type="password" id="password" name="password" placeholder="••••••••"
			/>
			if msg, ok := errors["password"]; ok {
				<p class="font-body-sm text-body-sm text-error mt-1">{ msg }</p>
			}
		</div>
		if msg, ok := errors["auth"]; ok {
			<p class="font-body-sm text-body-sm text-error">{ msg }</p>
		}
		<button
			type="submit"
			class="mt-2 w-full bg-primary text-on-primary py-3.5 px-6 rounded-lg font-semibold font-body-md text-body-md hover:bg-primary-container transition-colors duration-200 flex items-center justify-center gap-2 cursor-pointer border-none"
		>
			Se connecter
			<span class="material-symbols-outlined text-[20px]">login</span>
		</button>
	</form>
}
