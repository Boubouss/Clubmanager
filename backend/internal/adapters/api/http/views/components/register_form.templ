package components

templ RegisterForm(errors map[string]string, csrfToken string) {
	<form class="flex flex-col gap-md" method="POST" action="/user/inscription" novalidate>
		<input type="hidden" name="_csrf" value={ csrfToken }/>
		<div class="flex flex-col gap-1.5">
			<label class="font-body-sm text-body-sm font-semibold text-on-surface" for="username">Nom d'utilisateur</label>
			<input
				class="w-full px-4 py-3 bg-surface border border-outline-variant rounded-lg font-body-sm text-body-sm text-on-surface placeholder:text-outline input-focus transition-all"
				type="text" id="username" name="username" placeholder="ex: judoka42"
			/>
			if msg, ok := errors["username"]; ok {
				<p class="font-body-sm text-body-sm text-error mt-1">{ msg }</p>
			}
		</div>
		<div class="flex flex-col gap-1.5">
			<label class="font-body-sm text-body-sm font-semibold text-on-surface" for="email">Email</label>
			<input
				class="w-full px-4 py-3 bg-surface border border-outline-variant rounded-lg font-body-sm text-body-sm text-on-surface placeholder:text-outline input-focus transition-all"
				type="email" id="email" name="email" placeholder="vous@exemple.fr"
			/>
			if msg, ok := errors["email"]; ok {
				<p class="font-body-sm text-body-sm text-error mt-1">{ msg }</p>
			}
		</div>
		<div class="flex flex-col gap-1.5">
			<label class="font-body-sm text-body-sm font-semibold text-on-surface" for="phonenumber">
				Téléphone <span class="font-normal text-outline">(optionnel)</span>
			</label>
			<input
				class="w-full px-4 py-3 bg-surface border border-outline-variant rounded-lg font-body-sm text-body-sm text-on-surface placeholder:text-outline input-focus transition-all"
				type="tel" id="phonenumber" name="phonenumber" placeholder="+33 6 00 00 00 00"
			/>
			if msg, ok := errors["phonenumber"]; ok {
				<p class="font-body-sm text-body-sm text-error mt-1">{ msg }</p>
			}
		</div>
		<div class="flex flex-col gap-1.5">
			<label class="font-body-sm text-body-sm font-semibold text-on-surface" for="password">Mot de passe</label>
			<input
				class="w-full px-4 py-3 bg-surface border border-outline-variant rounded-lg font-body-sm text-body-sm text-on-surface placeholder:text-outline input-focus transition-all"
				type="password" id="password" name="password" placeholder="••••••••"
			/>
			<p class="text-xs text-outline italic mt-1">Minimum 8 caractères.</p>
			if msg, ok := errors["password"]; ok {
				<p class="font-body-sm text-body-sm text-error mt-1">{ msg }</p>
			}
		</div>
		if msg, ok := errors["register"]; ok {
			<p class="font-body-sm text-body-sm text-error">{ msg }</p>
		}
		<button
			type="submit"
			class="w-full py-3.5 px-6 bg-primary text-on-primary font-semibold font-body-md text-body-md rounded-lg shadow-sm hover:opacity-90 active:scale-[0.98] transition-all flex items-center justify-center gap-2 cursor-pointer border-none mt-2"
		>
			Créer mon compte
			<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
		</button>
	</form>
}
